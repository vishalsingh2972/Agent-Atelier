# Optional dedicated disposable PostgreSQL database. If omitted, DATABASE_URL is used only
# when WEBMCP_ALLOW_SHARED_DATABASE=true is also set.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/agentbridge_webmcp_test?sslmode=require"
# Required acknowledgement before integration tests can reset any database.
WEBMCP_TEST_DATABASE="true"
# Explicitly permits reset/seed tests to use DATABASE_URL when no separate test URL exists.
WEBMCP_ALLOW_SHARED_DATABASE="false"
# Set automatically by npm run test:webmcp:integration. Do not set for npm test.
WEBMCP_RUN_INTEGRATION="false"

# Optional browser E2E target. Leave blank to have Playwright start a local server.
# WEBMCP_E2E_BASE_URL="http://127.0.0.1:3010"
# WEBMCP_E2E_SEARCH_QUERY="laptop"

# Optional provider evaluation. Never commit this key.
# OPENAI_API_KEY=""
# WEBMCP_EVAL_MODEL="gpt-5.6-luna"
# WEBMCP_EVAL_RUNS="3"
